{
  "name": "netsuite-suitelens",
  "displayName": "SuiteLens for NetSuite",
  "description": "Field IDs, scripts, workflows and SuiteQL beside any NetSuite record. Production-safe. No server, no tracking. Open source.",
  "version": "1.0.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andynur/suitelens.git"
  },
  "bugs": {
    "url": "https://github.com/andynur/suitelens/issues"
  },
  "homepage": "https://github.com/andynur/suitelens#readme",
  "author": "Andy Nur <andynur.id@gmail.com> (https://www.andynur.my.id)",
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "dev": "wxt",
    "dev:fixtures": "cross-env VITE_SUITELENS_ADAPTER=fixture wxt",
    "build": "wxt build",
    "build:e2e": "cross-env VITE_SUITELENS_ADAPTER=fixture wxt build --mode e2e",
    "zip": "wxt zip",
    "postinstall": "wxt prepare",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "pnpm docs:build && pnpm build:e2e && playwright test",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm test:mcp && pnpm docs:build && pnpm build",
    "build:mcp": "pnpm --filter netsuite-suitelens-mcp build",
    "test:mcp": "pnpm build:mcp && pnpm --filter netsuite-suitelens-mcp test",
    "docs:build": "node tools/build-docs.mjs",
    "launch:assets": "pnpm build:e2e && SUITELENS_LAUNCH_ASSETS=1 playwright test launch-assets.spec.ts && node tools/finalize-demo.mjs",
    "store:assets": "pnpm build:e2e && SUITELENS_STORE_ASSETS=1 playwright test store-assets.spec.ts",
    "brand:icons": "node tools/render-icons.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@lezer/highlight": "^1.2.5",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "acorn": "^8.18.0",
    "idb": "^8.0.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sql-formatter": "^15.9.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.3",
    "@wxt-dev/module-react": "^1.2.2",
    "cross-env": "^10.1.0",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.13.0",
    "jsdom": "^30.1.1",
    "marked": "^18.1.0",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3",
    "wxt": "^0.21.4"
  },
  "engines": {
    "node": ">=22.22"
  }
}
